    {
      "name": "Appointments",
      "item": [
        {
          "name": "Create appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get('accessToken');",
                  "",
                  "if (!token) {",
                  "    console.warn('No accessToken: run the login request first');",
                  "}",
                  "",
                  "pm.request.headers.upsert({",
                  "    key: 'Authorization',",
                  "    value: `Bearer ${token}`",
                  "});",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/patients?limit=1',",
                  "    method: 'GET',",
                  "    header: { Authorization: `Bearer ${pm.collectionVariables.get('accessToken')}` }",
                  "}, (err, res) => {",
                  "    if (!err && res.code === 200 && res.json().data.length) {",
                  "        pm.collectionVariables.set('appointmentPatientId', res.json().data[0].id);",
                  "    }",
                  "});",
                  "",
                  "const date = new Date();",
                  "date.setUTCDate(date.getUTCDate() + 1 + Math.floor(Math.random() * 60));",
                  "date.setUTCHours(8 + Math.floor(Math.random() * 10), Math.floor(Math.random() * 60), 0, 0);",
                  "pm.collectionVariables.set('appointmentDate', date.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('appointmentId', pm.response.json().data.id);",
                  "}",
                  "",
                  "pm.test('Status 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
