            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Création d'un rendez-vous. `created_by` est l'utilisateur connecté. Le pre-request prend le premier patient de la liste (`appointmentPatientId`) et une date aléatoire dans les 60 prochains jours (`appointmentDate`). Deux rendez-vous `confirmed` du même patient dans une fenêtre de 30 minutes renvoient 409. L'id créé est enregistré dans `appointmentId`.",
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{appointmentPatientId}}\",\n  \"appointment_date\": \"{{appointmentDate}}\",\n  \"status\": \"pending\",\n  \"reason\": \"Consultation générale\",\n  \"notes\": null\n}"
            }
          }
        },
